{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python -m unittest *)",
      "Bash(python -m py_compile *)",
      "Bash(python .claude/tools/show_config.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "PowerShell(python -m unittest *)",
      "PowerShell(python .claude/tools/show_config.py*)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "ask": [
      "Edit(/data/learned_phrases.json)",
      "Bash(git commit*)",
      "PowerShell(git commit*)"
    ],
    "deny": [
      "Read(/config.py)",
      "Edit(/config.py)",
      "Edit(/data/unit_types.json)",
      "Bash(python main.py*)",
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git clean*)",
      "PowerShell(python main.py*)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git clean*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/guard.py"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/after_edit.py"],
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/run_tests.py"],
            "timeout": 600,
            "statusMessage": "Running the test suite"
          }
        ]
      }
    ]
  }
}
